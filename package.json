{
  "name": "@dadamjang/be",
  "version": "0.0.1",
  "description": "DADAMJANG GraphQL API and commerce domain services",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "format": "NODE_OPTIONS='--experimental-strip-types --disable-warning=ExperimentalWarning' prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migrate": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/migrate.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "NODE_OPTIONS='--experimental-strip-types --disable-warning=ExperimentalWarning' eslint \"{src,scripts,test}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "jest --config ./jest-unit.config.ts --runInBand",
    "test:integration": "NODE_ENV=test POSTGRES_HOST=127.0.0.1 POSTGRES_PORT=55432 POSTGRES_USERNAME=postgres POSTGRES_PASSWORD=postgres POSTGRES_DATABASE=dadamjang_test jest --config ./test/jest-integration.config.ts --runInBand",
    "test:watch": "jest --config ./jest-unit.config.ts --watch",
    "test:cov": "jest --config ./jest-unit.config.ts --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm test:integration",
    "db:test:up": "docker compose -f test/docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f test/docker-compose.test.yml down -v",
    "e2e:reset": "node dist/src/commands/e2e-reset.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@kr-yeon/kisa-seed": "1.0.5",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@sentry/nestjs": "^10.65.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-kakao": "^1.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-kakao": "^1.0.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ]
  }
}
